algoritmo "semnome"
// Função :
// Autor :
// Data : 06/04/2026
// Seção de Declarações
var

nro1 : inteiro
nro2 : inteiro
nro3 : inteiro

inicio
// Seção de Comandos

escreval("Digite o primeiro número:")
leia(nro1)
escreval("Digite o segundo número:")
leia(nro2)
escreval("Digite o terceiro número:")
leia(nro3)
se (nro1 > nro2) e (nro1 > nro3) entao
   escreval("O primeiro número é o maior!")
senao
fimse
se (nro2 > nro1) e (nro2 > nro3) entao
   escreval("O segundo número é o maior!")
senao
fimse
se (nro3 > nro1) e (nro3 > nro2) entao
   escreval("O terceiro número é o maior!")
senao
fimse

fimalgoritmo

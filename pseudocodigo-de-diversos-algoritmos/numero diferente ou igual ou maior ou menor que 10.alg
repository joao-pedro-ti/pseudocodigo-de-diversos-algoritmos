algoritmo "semnome"
// Função :
// Autor :
// Data : 06/04/2026
// Seção de Declarações 
var

nro : inteiro

inicio
// Seção de Comandos 

escreval("Digite um número:")
leia(nro)
se nro = 10 entao
escreval("Número igual a 10.")
senao
fimse
se nro > 10 entao
escreval("Número maior que 10.")
senao
fimse
se nro < 10 entao
escreval("Número menor que 10.")
senao
fimse
se nro <> 10 entao
escreva("Número diferente de 10.")
senao
fimse

fimalgoritmo

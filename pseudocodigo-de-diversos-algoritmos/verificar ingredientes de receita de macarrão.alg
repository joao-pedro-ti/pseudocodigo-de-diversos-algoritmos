algoritmo "semnome"
// Função :
// Autor :
// Data : 06/04/2026
// Seção de Declarações 
var

farinhaDeTrigo : logico
agua : logico
sal : logico
oleo : logico
queijo : logico

inicio
// Seção de Comandos 

escreval("Olá Tudo bem com você?")
escreval("")
escreval("=================== Verificando ingredientes ===================")
escreval("")
escreval("Tem farinha de trigo? VERDADEIRO ou FALSO:")
leia(farinhaDeTrigo)
se farinhaDeTrigo = VERDADEIRO entao
escreval("Certo!")
senao
escreva("Não conseguiremos fazer o macarrão.")
fimalgoritmo
fimse
escreval("Tem água? VERDADEIRO ou FALSO:")
leia(agua)
se agua = VERDADEIRO entao
escreval("Certo!")
senao
escreva("Não conseguiremos fazer o macarrão.")
fimalgoritmo
fimse
escreval("Tem sal? VERDADEIRO ou FALSO:")
leia(sal)
se sal = VERDADEIRO entao
escreval("Certo!")
senao
escreva("Não conseguiremos fazer o macarrão.")
fimalgoritmo
fimse
escreval("Tem óleo? VERDADEIRO ou FALSO:")
leia(oleo)
se oleo = VERDADEIRO entao
escreval("Certo!")
senao
escreva("Não conseguiremos fazer o macarrão.")
fimalgoritmo
fimse
escreval("Tem queijo? VERDADEIRO ou FALSO:")
leia(queijo)
se queijo = VERDADEIRO entao
escreval("Perfeito! Agora sim conseguiremos fazer esse macarrão!")
senao
escreval("Não conseguiremos fazer o macarrão.")
fimse
escreva("Hello world")

fimalgoritmo

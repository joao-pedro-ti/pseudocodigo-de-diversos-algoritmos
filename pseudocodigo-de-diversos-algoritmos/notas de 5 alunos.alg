algoritmo "semnome"
// Função :
// Autor :
// Data : 13/06/2026
// Seção de Declarações
var

nomeDoAluno : vetor[1..5] de caractere
notaDoAluno : vetor[1..4] de real
contador : inteiro

inicio
// Seção de Comandos

contador <- 0
para contador de 1 ate 4 faca
escreval("Digite o nome do aluno: ")
leia(nomeDoAluno[1])
escreval("Digite a nota do aluno: ")
leia(notaDoAluno[1])
escreval("Digite a nota do aluno: ")
leia(notaDoAluno[2])
escreval("Digite a nota do aluno: ")
leia(notaDoAluno[3])
escreval("Digite a nota do aluno: ")
leia(notaDoAluno[4])
escreval(nomeDoAluno[1])
escreval(notaDoAluno[1])
escreval(notaDoAluno[2])
escreval(notaDoAluno[3])
escreval(notaDoAluno[4])
fimpara
para contador de 1 ate 4 faca
escreval("Digite o nome do aluno: ")
leia(nomeDoAluno[2])
escreval("Digite a nota do aluno: ")
leia(notaDoAluno[1])
escreval("Digite a nota do aluno: ")
leia(notaDoAluno[2])
escreval("Digite a nota do aluno: ")
leia(notaDoAluno[3])
escreval("Digite a nota do aluno: ")
leia(notaDoAluno[4])
escreval(nomeDoAluno[2])
escreval(notaDoAluno[1])
escreval(notaDoAluno[2])
escreval(notaDoAluno[3])
escreval(notaDoAluno[4])
fimpara
para contador de 1 ate 4 faca
escreval("Digite o nome do aluno: ")
leia(nomeDoAluno[3])
escreval("Digite a nota do aluno: ")
leia(notaDoAluno[1])
escreval("Digite a nota do aluno: ")
leia(notaDoAluno[2])
escreval("Digite a nota do aluno: ")
leia(notaDoAluno[3])
escreval("Digite a nota do aluno: ")
leia(notaDoAluno[4])
escreval(nomeDoAluno[3])
escreval(notaDoAluno[1])
escreval(notaDoAluno[2])
escreval(notaDoAluno[3])
escreval(notaDoAluno[4])
fimpara
para contador de 1 ate 4 faca
escreval("Digite o nome do aluno: ")
leia(nomeDoAluno[4])
escreval("Digite a nota do aluno: ")
leia(notaDoAluno[1])
escreval("Digite a nota do aluno: ")
leia(notaDoAluno[2])
escreval("Digite a nota do aluno: ")
leia(notaDoAluno[3])
escreval("Digite a nota do aluno: ")
leia(notaDoAluno[4])
escreval(nomeDoAluno[4])
escreval(notaDoAluno[1])
escreval(notaDoAluno[2])
escreval(notaDoAluno[3])
escreval(notaDoAluno[4])
fimpara
para contador de 1 ate 4 faca
escreval("Digite o nome do aluno: ")
leia(nomeDoAluno[5])
escreval("Digite a nota do aluno: ")
leia(notaDoAluno[1])
escreval("Digite a nota do aluno: ")
leia(notaDoAluno[2])
escreval("Digite a nota do aluno: ")
leia(notaDoAluno[3])
escreval("Digite a nota do aluno: ")
leia(notaDoAluno[4])
escreval(nomeDoAluno[5])
escreval(notaDoAluno[1])
escreval(notaDoAluno[2])
escreval(notaDoAluno[3])
escreval(notaDoAluno[4])
fimpara

fimalgoritmo

algoritmo "semnome"
// Função :
// Autor :
// Data : 29/05/2026
// Seção de Declarações 
var

numeroMutavel : inteiro
numeroFixo : inteiro
resultado : inteiro

inicio
// Seção de Comandos 

escreval("============================ Tabuada 1 ao 10 ============================")
para numeroMutavel de 1 ate 10 faca
numeroFixo <- 1
resultado <- numeroFixo * numeroMutavel
escreval(numeroFixo, " x", numeroMutavel, " = ", resultado)
fimpara
escreval("=====================================================================")
para numeroMutavel de 1 ate 10 faca
numeroFixo <- 2
resultado <- numeroFixo * numeroMutavel
escreval(numeroFixo, " x", numeroMutavel, " = ", resultado)
fimpara
escreval("=====================================================================")
para numeroMutavel de 1 ate 10 faca
numeroFixo <- 3
resultado <- numeroFixo * numeroMutavel
escreval(numeroFixo, " x", numeroMutavel, " = ", resultado)
fimpara
escreval("=====================================================================")
para numeroMutavel de 1 ate 10 faca
numeroFixo <- 4
resultado <- numeroFixo * numeroMutavel
escreval(numeroFixo, " x", numeroMutavel, " = ", resultado)
fimpara
escreval("=====================================================================")
para numeroMutavel de 1 ate 10 faca
numeroFixo <- 5
resultado <- numeroFixo * numeroMutavel
escreval(numeroFixo, " x", numeroMutavel, " = ", resultado)
fimpara
escreval("=====================================================================")
para numeroMutavel de 1 ate 10 faca
numeroFixo <- 6
resultado <- numeroFixo * numeroMutavel
escreval(numeroFixo, " x", numeroMutavel, " = ", resultado)
fimpara
escreval("=====================================================================")
para numeroMutavel de 1 ate 10 faca
numeroFixo <- 7
resultado <- numeroFixo * numeroMutavel
escreval(numeroFixo, " x", numeroMutavel, " = ", resultado)
fimpara
escreval("=====================================================================")
para numeroMutavel de 1 ate 10 faca
numeroFixo <- 8
resultado <- numeroFixo * numeroMutavel
escreval(numeroFixo, " x", numeroMutavel, " = ", resultado)
fimpara
escreval("=====================================================================")
para numeroMutavel de 1 ate 10 faca
numeroFixo <- 9
resultado <- numeroFixo * numeroMutavel
escreval(numeroFixo, " x", numeroMutavel, " = ", resultado)
fimpara
escreval("=====================================================================")
para numeroMutavel de 1 ate 10 faca
numeroFixo <- 10
resultado <- numeroFixo * numeroMutavel
escreval(numeroFixo, " x", numeroMutavel, " = ", resultado)
fimpara
escreval("=====================================================================")

fimalgoritmo
